{
  "manifest_version": 3,
  "name": "Argentina IP Emulator",
  "version": "1.0",
  "description": "Emula ubicación y IP de Argentina",
  "permissions": [
    "webRequest",
    "tabs"
  ],
  "host_permissions": [
    "https://*.flow.com.ar/*",
    "https://argentina-proxy.vercel.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Argentina IP Emulator"
  }
}
