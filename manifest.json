{
  "manifest_version": 3,
  "name": "Argentina IP Emulator",
  "version": "1.0",
  "description": "Emula ubicación y IP de Argentina",
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "tabs",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Argentina IP Emulator"
  }
}
